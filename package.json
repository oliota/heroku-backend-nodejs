{
  "name": "heroku-backend-nodejs",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "heroku:init": "heroku login && heroku create heroku-backend-nodejs --stack heroku-22",
    "heroku:push": "git push heroku master:main",
    "heroku:open": "heroku open",
    "----": "echo ---------- INSTALL ----------",
    "install:deps": "npm install",
    "-----": "echo ---------- RUN ----------",
    "run": "node index.js",
    "------": "echo ---------- QUALITY ----------",
    "test": "node --test tests/*.test.js",
    "status": "node scripts/commands.js status",
    "list": "npm run",
    "help": "node scripts/commands.js help",
    "logs": "heroku logs --tail",
    "install": "node scripts/commands.js install",
    "test:adedonha": "node --test tests/adedonha.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "build": "node scripts/commands.js check",
    "lint": "node scripts/commands.js check",
    "format": "prettier --write adedonha tests/*.js scripts/*.js docs/ADEDONHA_FRONTEND_INTEGRATION.md data/adedonhaRules.json",
    "debug": "node --inspect index.js"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": "24.x"
  }
}
