# Existing services: keep their current Firebase project (oliota).
PORT=3002
GITHUB_TOKEN=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=oliota.firebaseapp.com
FIREBASE_PROJECT_ID=oliota
FIREBASE_STORAGE_BUCKET=oliota.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Independent Admin SDK; paste the PEM with literal \n for line breaks.
ADEDONHA_FIREBASE_PROJECT_ID=adedonha-stop
ADEDONHA_FIREBASE_CLIENT_EMAIL=
ADEDONHA_FIREBASE_PRIVATE_KEY=
ADEDONHA_CORS_ORIGINS=https://oliota.com,http://localhost:3000,http://localhost:3002

# Google Play service account with Android Publisher access. Production only.
ADEDONHA_PLAY_CLIENT_EMAIL=
ADEDONHA_PLAY_PRIVATE_KEY=
ADEDONHA_PLAY_PACKAGE_NAME=
ADEDONHA_PLAY_PRODUCT_ID=

# Apple App Store Server API. Production only, permanent non-consumable product.
ADEDONHA_APPLE_PRIVATE_KEY=
ADEDONHA_APPLE_KEY_ID=
ADEDONHA_APPLE_ISSUER_ID=
ADEDONHA_APPLE_BUNDLE_ID=
ADEDONHA_APPLE_APP_ID=
ADEDONHA_APPLE_PRODUCT_ID=
# Comma-separated base64 DER Apple root certificates; never accept client roots.
ADEDONHA_APPLE_ROOT_CERTIFICATES_BASE64=
